# Supabase public client configuration. Safe to expose in the browser.
# Get these from https://supabase.com/dashboard → Project Settings → API.
# Step-by-step setup lives in docs/SUPABASE-SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development-only UI bypass. Requires NODE_ENV=development and never bypasses production auth.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Server-only values. Do not commit real values; never expose to the browser.
# Only used by future server routes / Phase 2 backend jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI Provider configuration for Understanding Review and read-only Assistant.
# AI_BASE_URL is an OpenAI-compatible API root, for example https://api.openai.com/v1.
# The provider is replaceable; these values are never read by Client Components.
AI_PROVIDER_KEY=
AI_MODEL_KEY=
AI_BASE_URL=
AI_API_KEY=
